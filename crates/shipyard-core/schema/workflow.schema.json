{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shipyard.local/schema/workflow.schema.json",
  "title": "Shipyard workflow",
  "description": "One file in .shipyard/workflows/<id>.yaml (spec factory, REQ-010, REQ-012, REQ-035). The code also checks the needs cycles, the step ids, the roles and the for_each source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "steps", "limits"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_-]{1,64}$" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns", "budget_usd", "stall_s"],
      "properties": {
        "max_turns": { "type": "integer", "minimum": 1 },
        "budget_usd": { "type": "number", "exclusiveMinimum": 0 },
        "stall_s": { "type": "integer", "minimum": 1 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "oneOf": [{ "required": ["role"] }, { "required": ["action"] }],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "role": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] },
        "tools": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "skill": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["plan", "auto"], "default": "auto" },
        "workspace": { "enum": ["worktree", "shared", "none"], "default": "shared" },
        "needs": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "gate": { "enum": ["none", "human"], "default": "none" },
        "for_each": { "type": "string", "pattern": "^[a-z0-9_-]+\\.[^.].*$" },
        "max_parallel": { "type": "integer", "minimum": 1, "default": 2 },
        "retry": { "type": "integer", "minimum": 0, "default": 0 },
        "timeout": { "type": "integer", "minimum": 1 },
        "budget": { "type": "number", "exclusiveMinimum": 0 },
        "fresh_context": { "type": "boolean", "default": false },
        "max_rounds": { "type": "integer", "minimum": 0, "maximum": 2 },
        "action": { "enum": ["open_pr"] }
      }
    }
  }
}
