{
  "servers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "codebase-memory-mcp",
      "args": [
        "--tool-profile=analysis"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83"
      ]
    }
  }
}
