{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"],
		"verbatimModuleSyntax": true,
		"lib": ["ES2023"]
	},
	"include": ["vite.config.ts", "src/ui/shims", "scripts", ".github/scripts"]
}
